{
  "name": "deep-slots",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "MCP de QA para slots demo: navegador/Canvas, protocolo capi de Elk Studios y analisis de HAR",
  "bin": {
    "deep-slots": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.11.2",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2"
  }
}
